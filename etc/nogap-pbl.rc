#!/bin/csh

# Run configuration for compost
#
# Author(s):	Brad Weir <brad.weir@nasa.gov>
#
# Changelog:
# 2019-03-27	New version, based on compare_obspack_loop.csh
#
# Todo:
# * Port to bash, Python, or yaml
#===============================================================================

set EXPID    = d5294_geosit_jan18			# Experiment name
set GASCOLL  = trb_tavg_3hr_glo_L576x361_v73		# Gas collection name
set METCOLL  = asm_tavg_3hr_glo_L576x361_v72		# Met collection name
set YEAR0    = 2023					# Initial year
set YEARF    = 2024					# Final year
set UNTAR    = 0					# Need to untar? 0/1

set DIRAR    = /discover/nobackup/projects/gmao/geos-it/dao_ops/archive/d5294_geosit_jan18/diag		# Model archive directory
set DIROUT   = /discover/nobackup/bweir/compost/output/nogap						# Comparison output directory

# Directories for comparison datasets
set DIRNGAPCO2 = /discover/nobackup/ghg_ops/noaa/data/misc

set VARPHIS = 'PHIS'					# Surface geopotential
set VARPS   = 'PS'					# Surface pressure
set VARZL   = 'H'					# Geopotential heights
set VARQW   = ''					# Total water

set TTMET   = 'yyyy-mm-ddTHHMMZ'			# Model time format (meteo)
set TTGAS   = 'yyyy-mm-ddTHHMMZ'			# Model time format (tracer)
set DSKIP   = 1/8					# Timestep (fraction of day)

#  --- Observation --------------  Data         --- Obs ------ --- Mod ---------
#  name      type     eval id      directory    var    scale   var    scale   d?
#  -----------------------------------------------------------------------------
set OBSINFO = (\
   obspack   station  ri_gap       $DIRNGAPCO2  co2    1.0e+06 RI     1.0     1 \
   obspack   mobile   ri_gap       $DIRNGAPCO2  co2    1.0e+06 RI     1.0     1 \
)
